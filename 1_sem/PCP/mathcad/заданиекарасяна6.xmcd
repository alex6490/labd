	<regions>
		<region region-id="9" left="60" top="123" width="204.75" height="286.5" align-x="102" align-y="132" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">res</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">a</ml:id>
							<ml:id xml:space="preserve">b</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:program>
						<ml:localDefine>
							<ml:id xml:space="preserve">i</ml:id>
							<ml:id xml:space="preserve">a</ml:id>
						</ml:localDefine>
						<ml:localDefine>
							<ml:id xml:space="preserve">k</ml:id>
							<ml:real>0</ml:real>
						</ml:localDefine>
						<ml:localDefine>
							<ml:id xml:space="preserve">res</ml:id>
							<ml:real>1</ml:real>
						</ml:localDefine>
						<ml:while>
							<ml:apply>
								<ml:lessOrEqual/>
								<ml:id xml:space="preserve">i</ml:id>
								<ml:id xml:space="preserve">b</ml:id>
							</ml:apply>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">t</ml:id>
									<ml:id xml:space="preserve">i</ml:id>
								</ml:localDefine>
								<ml:localDefine>
									<ml:id xml:space="preserve">n</ml:id>
									<ml:apply>
										<ml:plus/>
										<ml:apply>
											<ml:id xml:space="preserve">floor</ml:id>
											<ml:apply>
												<ml:id xml:space="preserve">log</ml:id>
												<ml:id xml:space="preserve">i</ml:id>
											</ml:apply>
										</ml:apply>
										<ml:real>1</ml:real>
									</ml:apply>
								</ml:localDefine>
								<ml:localDefine>
									<ml:id xml:space="preserve">s</ml:id>
									<ml:real>0</ml:real>
								</ml:localDefine>
								<ml:while>
									<ml:apply>
										<ml:greaterThan/>
										<ml:id xml:space="preserve">t</ml:id>
										<ml:real>0</ml:real>
									</ml:apply>
									<ml:program>
										<ml:localDefine>
											<ml:id xml:space="preserve">d</ml:id>
											<ml:apply>
												<ml:id xml:space="preserve">mod</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">t</ml:id>
													<ml:real>10</ml:real>
												</ml:sequence>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:id xml:space="preserve">s</ml:id>
											<ml:apply>
												<ml:plus/>
												<ml:id xml:space="preserve">s</ml:id>
												<ml:apply>
													<ml:pow/>
													<ml:id xml:space="preserve">d</ml:id>
													<ml:id xml:space="preserve">n</ml:id>
												</ml:apply>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:id xml:space="preserve">t</ml:id>
											<ml:apply>
												<ml:id xml:space="preserve">floor</ml:id>
												<ml:apply>
													<ml:div/>
													<ml:id xml:space="preserve">t</ml:id>
													<ml:real>10</ml:real>
												</ml:apply>
											</ml:apply>
										</ml:localDefine>
									</ml:program>
								</ml:while>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">i</ml:id>
										<ml:id xml:space="preserve">s</ml:id>
									</ml:apply>
									<ml:ifThen>
										<ml:apply>
											<ml:or/>
											<ml:parens>
												<ml:apply>
													<ml:greaterOrEqual/>
													<ml:id xml:space="preserve">n</ml:id>
													<ml:real>3</ml:real>
												</ml:apply>
											</ml:parens>
											<ml:parens>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">i</ml:id>
													<ml:real>1</ml:real>
												</ml:apply>
											</ml:parens>
										</ml:apply>
										<ml:program>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">res</ml:id>
													<ml:id xml:space="preserve">k</ml:id>
												</ml:apply>
												<ml:id xml:space="preserve">i</ml:id>
											</ml:localDefine>
											<ml:localDefine>
												<ml:id xml:space="preserve">k</ml:id>
												<ml:apply>
													<ml:plus/>
													<ml:id xml:space="preserve">k</ml:id>
													<ml:real>1</ml:real>
												</ml:apply>
											</ml:localDefine>
										</ml:program>
									</ml:ifThen>
								</ml:ifThen>
								<ml:localDefine>
									<ml:id xml:space="preserve">i</ml:id>
									<ml:apply>
										<ml:plus/>
										<ml:id xml:space="preserve">i</ml:id>
										<ml:real>1</ml:real>
									</ml:apply>
								</ml:localDefine>
							</ml:program>
						</ml:while>
						<ml:id xml:space="preserve">res</ml:id>
					</ml:program>
				</ml:define>
			</math>
			<rendering item-idref="1"/>
		</region>
